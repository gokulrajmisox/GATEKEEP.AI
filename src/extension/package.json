{
  "name": "gatekeep-ai-extension",
  "version": "1.0.0",
  "private": true,
  "main": "background.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "node build.js",
    "test": "node tests/content-script.test.js",
    "benchmark": "node benchmarks/benchmark.js",
    "benchmark:json": "node benchmarks/benchmark.js --json",
    "evaluate": "node benchmarks/evaluate.js",
    "evaluate:ner": "node benchmarks/ner-evaluate.mjs",
    "audit": "npm audit --audit-level=critical"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "esbuild": "0.27.1",
    "onnxruntime-web": "^1.23.2"
  },
  "keywords": ["browser-extension", "privacy", "pii", "security"],
  "author": "GATEKEEP.AI contributors",
  "license": "MIT",
  "description": "Local browser privacy firewall for safer AI interactions"
}
